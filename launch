#!/usr/bin/env bash
# One-click local Practice Desk + Riff Room helper.
# Usage: ./launch               this Mac only
#        ./launch --phone       also open it to your phone on the same Wi-Fi
#        ./launch --stems       install audio splitting first (one time)
set -euo pipefail
cd "$(dirname "$0")"

phone=""
for arg in "$@"; do
  case "$arg" in
    --stems) stems=1 ;;
    --phone) phone="--phone" ;;
    *) echo "Unknown option: $arg (use --phone and/or --stems)"; exit 1 ;;
  esac
done

# Install (or update) JavaScript packages when they are missing or when
# package-lock.json changed since the last install (for example after git pull).
if [[ ! -f node_modules/.package-lock.json || package-lock.json -nt node_modules/.package-lock.json ]]; then
  echo "Installing npm packages…"
  npm install
fi

if [[ -n "${stems:-}" ]]; then
  echo "Setting up audio splitting (one time)…"
  npm run setup:stems
fi

# Optional local tools for Riff Room downloads (desk still runs without them).
command -v ffmpeg >/dev/null || echo "Note: ffmpeg not found — Riff Room downloads need it (brew install ffmpeg)."
command -v yt-dlp >/dev/null || echo "Note: yt-dlp not found — Riff Room downloads need it (brew install yt-dlp)."

echo "Starting Practice Desk → http://localhost:5173"
exec node scripts/dev.mjs $phone
